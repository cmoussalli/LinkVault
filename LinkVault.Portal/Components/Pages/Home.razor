@page "/"

<PageTitle>LinkVault - Modern Link Management Platform</PageTitle>

<!-- Hero Section -->
<div class="bg-white">
    <div class="position-relative overflow-hidden">
        <!-- Gradient Background -->
        <div class="position-absolute top-0 start-0 w-100 h-100" style="background: linear-gradient(135deg, rgba(99, 102, 241, 0.05) 0%, rgba(139, 92, 246, 0.05) 100%); z-index: 0;"></div>

        <div class="container position-relative" style="z-index: 1;">
            <div class="row align-items-center py-5 min-vh-100">
                <div class="col-lg-6 py-5">
                    <!-- Badge -->
                    <div class="d-inline-flex align-items-center gap-2 px-3 py-2 mb-4 rounded-pill" style="background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%); color: white; font-size: 0.875rem; font-weight: 600;">
                        <i class="bi bi-lightning-charge-fill"></i>
                        <span>Powerful Link Management</span>
                    </div>

                    <!-- Headline -->
                    <h1 class="display-3 fw-bold mb-4" style="line-height: 1.2;">
                        Shorten, Track, and
                        <span class="gradient-text d-block">Optimize Your Links</span>
                    </h1>

                    <!-- Description -->
                    <p class="lead text-muted mb-4 fs-5">
                        Transform your long URLs into powerful short links with comprehensive analytics.
                        Built for teams who care about data and performance.
                    </p>

                    <!-- CTA Buttons -->
                    <div class="d-flex flex-wrap gap-3 mb-5">
                        <a href="/admin/links/create" class="btn btn-primary btn-lg px-4 d-inline-flex align-items-center gap-2">
                            Get Started Free
                            <i class="bi bi-arrow-right"></i>
                        </a>
                        <a href="/admin" class="btn btn-outline-primary btn-lg px-4 d-inline-flex align-items-center gap-2">
                            <i class="bi bi-play-circle"></i>
                            View Dashboard
                        </a>
                    </div>

                    <!-- Stats -->
                    <div class="d-flex flex-wrap gap-4">
                        <div class="text-center">
                            <div class="fw-bold fs-3 gradient-text">99.9%</div>
                            <div class="text-muted small">Uptime</div>
                        </div>
                        <div class="text-center">
                            <div class="fw-bold fs-3 gradient-text">10ms</div>
                            <div class="text-muted small">Avg Response</div>
                        </div>
                        <div class="text-center">
                            <div class="fw-bold fs-3 gradient-text">∞</div>
                            <div class="text-muted small">Scale Ready</div>
                        </div>
                    </div>
                </div>

                <!-- Hero Visual -->
                <div class="col-lg-6 py-5">
                    <div class="card border-0 shadow-lg float" style="border-radius: 1rem; overflow: hidden;">
                        <div class="card-header bg-white border-bottom d-flex align-items-center justify-content-between py-3">
                            <div class="d-flex gap-2">
                                <div class="rounded-circle bg-danger" style="width: 12px; height: 12px;"></div>
                                <div class="rounded-circle bg-warning" style="width: 12px; height: 12px;"></div>
                                <div class="rounded-circle bg-success" style="width: 12px; height: 12px;"></div>
                            </div>
                            <small class="text-muted fw-semibold">LinkVault Dashboard</small>
                            <div style="width: 60px;"></div>
                        </div>
                        <div class="card-body p-4">
                            <!-- Preview Card -->
                            <div class="d-flex align-items-center justify-content-between p-3 mb-3 rounded" style="background: linear-gradient(135deg, rgba(99, 102, 241, 0.1) 0%, rgba(139, 92, 246, 0.1) 100%);">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="d-flex align-items-center justify-content-center rounded-circle" style="width: 48px; height: 48px; background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%); color: white;">
                                        <i class="bi bi-link-45deg fs-4"></i>
                                    </div>
                                    <div>
                                        <div class="text-muted small">Short Link</div>
                                        <div class="fw-semibold">linkvault.io/abc123</div>
                                    </div>
                                </div>
                                <span class="badge bg-success">Active</span>
                            </div>

                            <!-- Preview Chart -->
                            <div class="d-flex align-items-end justify-content-between gap-2" style="height: 120px;">
                                <div class="rounded-top" style="width: 100%; height: 45%; background: linear-gradient(180deg, #6366f1 0%, #8b5cf6 100%);"></div>
                                <div class="rounded-top" style="width: 100%; height: 70%; background: linear-gradient(180deg, #6366f1 0%, #8b5cf6 100%);"></div>
                                <div class="rounded-top" style="width: 100%; height: 55%; background: linear-gradient(180deg, #6366f1 0%, #8b5cf6 100%);"></div>
                                <div class="rounded-top" style="width: 100%; height: 90%; background: linear-gradient(180deg, #6366f1 0%, #8b5cf6 100%);"></div>
                                <div class="rounded-top" style="width: 100%; height: 75%; background: linear-gradient(180deg, #6366f1 0%, #8b5cf6 100%);"></div>
                                <div class="rounded-top" style="width: 100%; height: 100%; background: linear-gradient(180deg, #6366f1 0%, #8b5cf6 100%);"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Features Section -->
<section class="py-5 bg-light">
    <div class="container py-5">
        <!-- Section Header -->
        <div class="text-center mb-5">
            <h2 class="display-5 fw-bold mb-3">Everything you need to manage links</h2>
            <p class="lead text-muted">Powerful features designed for modern teams</p>
        </div>

        <!-- Features Grid -->
        <div class="row g-4">
            <!-- Feature 1 -->
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body p-4 text-center">
                        <div class="d-flex align-items-center justify-content-center rounded-circle mx-auto mb-3" style="width: 64px; height: 64px; background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);">
                            <i class="bi bi-lightning-charge fs-3 text-white"></i>
                        </div>
                        <h4 class="fw-bold mb-3">Lightning Fast</h4>
                        <p class="text-muted">Sub-10ms redirects ensure your users never wait. Built on cutting-edge infrastructure.</p>
                    </div>
                </div>
            </div>

            <!-- Feature 2 -->
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body p-4 text-center">
                        <div class="d-flex align-items-center justify-content-center rounded-circle mx-auto mb-3" style="width: 64px; height: 64px; background: linear-gradient(135deg, #10b981 0%, #06b6d4 100%);">
                            <i class="bi bi-graph-up-arrow fs-3 text-white"></i>
                        </div>
                        <h4 class="fw-bold mb-3">Advanced Analytics</h4>
                        <p class="text-muted">Deep insights into clicks, geography, devices, and referrers. Make data-driven decisions.</p>
                    </div>
                </div>
            </div>

            <!-- Feature 3 -->
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body p-4 text-center">
                        <div class="d-flex align-items-center justify-content-center rounded-circle mx-auto mb-3" style="width: 64px; height: 64px; background: linear-gradient(135deg, #f59e0b 0%, #ef4444 100%);">
                            <i class="bi bi-shield-check fs-3 text-white"></i>
                        </div>
                        <h4 class="fw-bold mb-3">Enterprise Security</h4>
                        <p class="text-muted">Bank-level encryption and security. Your data is safe with us, always.</p>
                    </div>
                </div>
            </div>

            <!-- Feature 4 -->
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body p-4 text-center">
                        <div class="d-flex align-items-center justify-content-center rounded-circle mx-auto mb-3" style="width: 64px; height: 64px; background: linear-gradient(135deg, #8b5cf6 0%, #ec4899 100%);">
                            <i class="bi bi-palette fs-3 text-white"></i>
                        </div>
                        <h4 class="fw-bold mb-3">Custom Branding</h4>
                        <p class="text-muted">Use your own domain and create branded links that build trust with your audience.</p>
                    </div>
                </div>
            </div>

            <!-- Feature 5 -->
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body p-4 text-center">
                        <div class="d-flex align-items-center justify-content-center rounded-circle mx-auto mb-3" style="width: 64px; height: 64px; background: linear-gradient(135deg, #06b6d4 0%, #3b82f6 100%);">
                            <i class="bi bi-clock-history fs-3 text-white"></i>
                        </div>
                        <h4 class="fw-bold mb-3">Link Expiration</h4>
                        <p class="text-muted">Set expiration dates for temporary campaigns and time-sensitive content.</p>
                    </div>
                </div>
            </div>

            <!-- Feature 6 -->
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body p-4 text-center">
                        <div class="d-flex align-items-center justify-content-center rounded-circle mx-auto mb-3" style="width: 64px; height: 64px; background: linear-gradient(135deg, #14b8a6 0%, #22c55e 100%);">
                            <i class="bi bi-file-earmark-code fs-3 text-white"></i>
                        </div>
                        <h4 class="fw-bold mb-3">Content Links</h4>
                        <p class="text-muted">Serve HTML, JSON, or images directly. Perfect for API responses and dynamic content.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Stats Section -->
<section class="py-5 bg-white">
    <div class="container py-5">
        <div class="card border-0 shadow-lg p-5" style="border-radius: 1rem; background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);">
            <div class="row g-4 text-center text-white">
                <div class="col-6 col-lg-3">
                    <div class="display-4 fw-bold">∞</div>
                    <div class="text-white-50 fw-semibold">Links Created</div>
                </div>
                <div class="col-6 col-lg-3">
                    <div class="display-4 fw-bold">100%</div>
                    <div class="text-white-50 fw-semibold">Reliability</div>
                </div>
                <div class="col-6 col-lg-3">
                    <div class="display-4 fw-bold">24/7</div>
                    <div class="text-white-50 fw-semibold">Support</div>
                </div>
                <div class="col-6 col-lg-3">
                    <div class="display-4 fw-bold">&lt;10ms</div>
                    <div class="text-white-50 fw-semibold">Response Time</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="py-5 bg-light">
    <div class="container py-5">
        <div class="text-center">
            <h2 class="display-5 fw-bold mb-3">Ready to supercharge your links?</h2>
            <p class="lead text-muted mb-4">
                Join thousands of developers and marketers who trust LinkVault for their link management.
            </p>
            <div class="d-flex flex-wrap justify-content-center gap-3">
                <a href="/admin/links/create" class="btn btn-primary btn-lg px-5 d-inline-flex align-items-center gap-2">
                    Start Creating Links
                    <i class="bi bi-arrow-right"></i>
                </a>
                <a href="/admin" class="btn btn-outline-primary btn-lg px-5">
                    Explore Dashboard
                </a>
            </div>
        </div>
    </div>
</section>

<!-- Footer -->
<footer class="bg-dark text-white py-5">
    <div class="container">
        <div class="row">
            <div class="col-lg-6 mb-4 mb-lg-0">
                <h3 class="fw-bold mb-3">LinkVault</h3>
                <p class="text-white-50">Modern link management for modern teams.</p>
            </div>
            <div class="col-lg-6">
                <div class="d-flex flex-wrap gap-4 justify-content-lg-end">
                    <a href="/admin" class="text-white text-decoration-none">Dashboard</a>
                    <a href="/admin/links" class="text-white text-decoration-none">Links</a>
                    <a href="/admin/analytics" class="text-white text-decoration-none">Analytics</a>
                </div>
            </div>
        </div>
        <hr class="my-4 border-secondary" />
        <div class="text-center text-white-50">
            <p class="mb-0">&copy; 2025 LinkVault. Built with <i class="bi bi-heart-fill text-danger"></i> using .NET 9</p>
        </div>
    </div>
</footer>
