@page "/login"
@layout LoginLayout

<div class="min-vh-100 d-flex align-items-center justify-content-center position-relative" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
    <!-- Animated Background Pattern -->
    <div class="position-absolute top-0 start-0 w-100 h-100" style="background-image: radial-gradient(circle at 20% 50%, rgba(255, 255, 255, 0.1) 0%, transparent 50%), radial-gradient(circle at 80% 80%, rgba(255, 255, 255, 0.1) 0%, transparent 50%); z-index: 0;"></div>

    <div class="container position-relative" style="z-index: 1;">
        <div class="row justify-content-center">
            <!-- Login Card -->
            <div class="col-12 col-md-10 col-lg-8 col-xl-6">
                <div class="card border-0 shadow-lg" style="border-radius: 1.5rem; overflow: hidden;">
                    <div class="row g-0">
                        <!-- Login Form Section -->
                        <div class="col-lg-7">
                            <div class="card-body p-5">
                                <!-- Logo & Header -->
                                <div class="text-center mb-4">
                                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3" style="width: 64px; height: 64px; background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);">
                                        <i class="bi bi-shield-lock fs-3 text-white"></i>
                                    </div>
                                    <h1 class="h3 fw-bold mb-2">Welcome to LinkVault</h1>
                                    <p class="text-muted">Please login to your account</p>
                                </div>

                                <!-- Login Form Component -->
                                <LoginPart />

                                <!-- Security Badges -->
                                <div class="mt-4">
                                    <div class="text-center mb-3">
                                        <small class="text-muted text-uppercase fw-semibold" style="letter-spacing: 0.05em;">Secure Access</small>
                                    </div>
                                    <div class="d-flex justify-content-center gap-4">
                                        <div class="text-center">
                                            <i class="bi bi-shield-check fs-4 text-success"></i>
                                            <div class="small text-muted mt-1">Encrypted</div>
                                        </div>
                                        <div class="text-center">
                                            <i class="bi bi-lock-fill fs-4 text-primary"></i>
                                            <div class="small text-muted mt-1">Secure</div>
                                        </div>
                                        <div class="text-center">
                                            <i class="bi bi-eye-slash fs-4 text-info"></i>
                                            <div class="small text-muted mt-1">Private</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Features Sidebar -->
                        <div class="col-lg-5 d-none d-lg-block" style="background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);">
                            <div class="h-100 p-5 d-flex flex-column justify-content-center text-white">
                                <h3 class="fw-bold mb-4">Why LinkVault?</h3>

                                <div class="mb-4">
                                    <div class="d-flex align-items-start gap-3 mb-3">
                                        <div class="d-flex align-items-center justify-content-center rounded-circle flex-shrink-0" style="width: 48px; height: 48px; background: rgba(255, 255, 255, 0.2);">
                                            <i class="bi bi-link-45deg fs-4"></i>
                                        </div>
                                        <div>
                                            <h5 class="fw-semibold mb-1">Manage Links</h5>
                                            <p class="small text-white-50 mb-0">Organize and secure all your important links</p>
                                        </div>
                                    </div>

                                    <div class="d-flex align-items-start gap-3 mb-3">
                                        <div class="d-flex align-items-center justify-content-center rounded-circle flex-shrink-0" style="width: 48px; height: 48px; background: rgba(255, 255, 255, 0.2);">
                                            <i class="bi bi-graph-up fs-4"></i>
                                        </div>
                                        <div>
                                            <h5 class="fw-semibold mb-1">Track Analytics</h5>
                                            <p class="small text-white-50 mb-0">Monitor link performance and engagement</p>
                                        </div>
                                    </div>

                                    <div class="d-flex align-items-start gap-3">
                                        <div class="d-flex align-items-center justify-content-center rounded-circle flex-shrink-0" style="width: 48px; height: 48px; background: rgba(255, 255, 255, 0.2);">
                                            <i class="bi bi-shield-fill-check fs-4"></i>
                                        </div>
                                        <div>
                                            <h5 class="fw-semibold mb-1">Enterprise Security</h5>
                                            <p class="small text-white-50 mb-0">Bank-level encryption for your data</p>
                                        </div>
                                    </div>
                                </div>

                                <div class="mt-auto pt-4">
                                    <p class="small text-white-50 mb-0">
                                        <i class="bi bi-check-circle-fill me-2"></i>
                                        Trusted by thousands of users worldwide
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Mobile Features (visible only on small screens) -->
                <div class="d-lg-none mt-4">
                    <div class="row g-3">
                        <div class="col-12">
                            <div class="card border-0 bg-white bg-opacity-10 backdrop-blur">
                                <div class="card-body p-3 text-white">
                                    <div class="d-flex align-items-center gap-3">
                                        <i class="bi bi-link-45deg fs-3"></i>
                                        <div>
                                            <h6 class="fw-semibold mb-0">Manage Links</h6>
                                            <small class="text-white-50">Organize securely</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="card border-0 bg-white bg-opacity-10">
                                <div class="card-body p-3 text-white text-center">
                                    <i class="bi bi-graph-up fs-3 mb-2"></i>
                                    <div class="small">Track Analytics</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="card border-0 bg-white bg-opacity-10">
                                <div class="card-body p-3 text-white text-center">
                                    <i class="bi bi-shield-fill-check fs-3 mb-2"></i>
                                    <div class="small">Secure</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Back to Home Link -->
                <div class="text-center mt-4">
                    <a href="/" class="text-white text-decoration-none">
                        <i class="bi bi-arrow-left me-2"></i>
                        Back to Home
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@code {

}
