@page "/admin/links/create"
@page "/admin/links/edit/{id:int}"
@layout AdminLayout
@using LinkVault.Portal.Services
@using LinkVault.Portal.Models
@using System.ComponentModel.DataAnnotations
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>@(IsEditMode ? "Edit Link" : "Create Link") - LinkVault Admin</PageTitle>

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-2">@(IsEditMode ? "Edit Link" : "Create New Link")</h2>
        <p class="text-muted mb-0">@(IsEditMode ? "Update your short link settings" : "Create a new short link or content link")</p>
    </div>
    <a href="/admin/links" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
        <i class="bi bi-arrow-left"></i>
        <span>Back to Links</span>
    </a>
</div>

<div class="row g-4">
    <!-- Form Column -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <EditForm Model="linkModel" OnValidSubmit="SaveLink" @ref="editForm">
                    <DataAnnotationsValidator />

                    <!-- Title Field -->
                    <div class="mb-4">
                        <label for="title" class="form-label fw-semibold">
                            <i class="bi bi-card-heading text-primary me-2"></i>
                            Title
                        </label>
                        <InputText id="title"
                                   class="form-control"
                                   @bind-Value="linkModel.Title"
                                   placeholder="e.g., My Product Page" />
                        <div class="form-text">Optional: A friendly name to identify this link</div>
                        <ValidationMessage For="@(() => linkModel.Title)" />
                    </div>

                    <!-- Link Type Selection -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-ui-radios text-primary me-2"></i>
                            Link Type *
                        </label>
                        <InputRadioGroup @bind-Value="linkModel.Type">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="card h-100 border-2" style="cursor: pointer;">
                                        <div class="card-body p-3">
                                            <div class="form-check">
                                                <InputRadio id="typeRedirect" class="form-check-input" Value="LinkType.Redirect" />
                                                <label class="form-check-label w-100" for="typeRedirect" style="cursor: pointer;">
                                                    <div class="d-flex align-items-start gap-2">
                                                        <i class="bi bi-box-arrow-up-right fs-4 text-primary"></i>
                                                        <div>
                                                            <div class="fw-semibold">Redirect to URL</div>
                                                            <small class="text-muted">Redirect visitors to another website</small>
                                                        </div>
                                                    </div>
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="card h-100 border-2" style="cursor: pointer;">
                                        <div class="card-body p-3">
                                            <div class="form-check">
                                                <InputRadio id="typeContent" class="form-check-input" Value="LinkType.Content" />
                                                <label class="form-check-label w-100" for="typeContent" style="cursor: pointer;">
                                                    <div class="d-flex align-items-start gap-2">
                                                        <i class="bi bi-file-earmark-text fs-4 text-success"></i>
                                                        <div>
                                                            <div class="fw-semibold">Show Content</div>
                                                            <small class="text-muted">Serve HTML, JSON, or images</small>
                                                        </div>
                                                    </div>
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </InputRadioGroup>
                    </div>

                    <!-- Redirect URL Field (conditional) -->
                    @if (linkModel.Type == LinkType.Redirect)
                    {
                        <div class="mb-4">
                            <label for="RedirectUrl" class="form-label fw-semibold">
                                <i class="bi bi-link-45deg text-primary me-2"></i>
                                Redirect URL *
                            </label>
                            <InputText id="RedirectUrl"
                                       class="form-control"
                                       @bind-Value="linkModel.RedirectUrl"
                                       placeholder="https://example.com/my-page" />
                            <div class="form-text">The destination URL where visitors will be redirected</div>
                            <ValidationMessage For="@(() => linkModel.RedirectUrl)" />
                        </div>
                    }
                    else
                    {
                        <!-- Content Selection (conditional) -->
                        <div class="mb-4">
                            <label for="contentPath" class="form-label fw-semibold">
                                <i class="bi bi-folder text-primary me-2"></i>
                                Select Content *
                            </label>
                            <InputSelect id="contentPath"
                                         class="form-select"
                                         @bind-Value="linkModel.ContentPath"
                                         @bind-Value:after="OnContentPathChanged">
                                <option value="">-- Select Content File --</option>
                                @if (availableContent != null)
                                {
                                    @foreach (var content in availableContent)
                                    {
                                        <option value="@content.FilePath">@content.FileName (@content.ContentType)</option>
                                    }
                                }
                            </InputSelect>
                            <div class="form-text">Choose from pre-uploaded HTML, JSON, or image files</div>
                            <ValidationMessage For="@(() => linkModel.ContentPath)" />
                        </div>
                    }

                    <!-- Short Code Field -->
                    <div class="mb-4">
                        <label for="shortCode" class="form-label fw-semibold">
                            <i class="bi bi-code-square text-primary me-2"></i>
                            Custom Short Code
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light">
                                <i class="bi bi-link me-1"></i>
                                @Navigation.BaseUri.TrimEnd('/')/
                            </span>
                            <InputText id="shortCode"
                                       class="form-control"
                                       @bind-Value="linkModel.ShortCode"
                                       placeholder="my-link" />
                            <button type="button"
                                    class="btn btn-outline-primary"
                                    @onclick="GenerateShortCode">
                                <i class="bi bi-arrow-clockwise"></i>
                            </button>
                        </div>
                        <div class="form-text">Letters, numbers, and hyphens only. Leave empty for auto-generation.</div>
                        <ValidationMessage For="@(() => linkModel.ShortCode)" />
                    </div>

                    <!-- Expiration Date Field -->
                    <div class="mb-4">
                        <label for="expiresAt" class="form-label fw-semibold">
                            <i class="bi bi-calendar-x text-primary me-2"></i>
                            Expiration Date
                        </label>
                        <InputDate id="expiresAt" class="form-control" @bind-Value="linkModel.ExpiresAt" />
                        <div class="form-text">Optional: Set when this link should expire</div>
                        <ValidationMessage For="@(() => linkModel.ExpiresAt)" />
                    </div>

                    <!-- Active Toggle -->
                    <div class="mb-4">
                        <div class="card bg-light border-0">
                            <div class="card-body p-3">
                                <div class="form-check form-switch">
                                    <InputCheckbox id="isActive"
                                                   class="form-check-input"
                                                   @bind-Value="linkModel.IsActive"
                                                   style="cursor: pointer;" />
                                    <label class="form-check-label fw-semibold" for="isActive" style="cursor: pointer;">
                                        <i class="bi bi-toggle-on text-success me-2"></i>
                                        Link is Active
                                    </label>
                                    <div class="form-text mt-2">Inactive links will return a 404 error</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Validation Summary -->
                    <ValidationSummary class="alert alert-danger" />

                    <!-- Action Buttons -->
                    <div class="d-flex gap-2 pt-3 border-top">
                        <button type="submit" class="btn btn-primary px-4" disabled="@isSubmitting">
                            @if (isSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            }
                            <i class="bi bi-@(IsEditMode ? "check" : "plus")-circle me-2"></i>
                            @(IsEditMode ? "Update Link" : "Create Link")
                        </button>
                        <a href="/admin/links" class="btn btn-outline-secondary px-4">
                            <i class="bi bi-x-circle me-2"></i>
                            Cancel
                        </a>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>

    <!-- Preview Column -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm sticky-top" style="top: 1rem;">
            <div class="card-header bg-white border-bottom">
                <h6 class="mb-0 fw-bold">
                    <i class="bi bi-eye text-primary me-2"></i>
                    Preview
                </h6>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(linkModel.ShortCode))
                {
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-muted">SHORT URL</label>
                        <div class="input-group input-group-sm">
                            <input type="text"
                                   class="form-control bg-light"
                                   value="@GetPreviewUrl()"
                                   readonly />
                            <button type="button"
                                    class="btn btn-outline-secondary"
                                    @onclick="() => CopyToClipboard(GetPreviewUrl())"
                                    title="Copy URL">
                                <i class="bi bi-clipboard"></i>
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-info small mb-3">
                        <i class="bi bi-info-circle me-2"></i>
                        Enter a short code to see the preview URL
                    </div>
                }

                @if (linkModel.Type == LinkType.Redirect && !string.IsNullOrEmpty(linkModel.RedirectUrl))
                {
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-muted">REDIRECTS TO</label>
                        <p class="small text-break mb-0 p-2 bg-light rounded">
                            <i class="bi bi-box-arrow-up-right text-primary me-2"></i>
                            @linkModel.RedirectUrl
                        </p>
                    </div>
                }
                else if (linkModel.Type == LinkType.Content && !string.IsNullOrEmpty(linkModel.ContentPath))
                {
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-muted">SHOWS CONTENT</label>
                        <div class="p-2 bg-light rounded">
                            <p class="small text-break mb-1">
                                <i class="bi bi-file-earmark text-success me-2"></i>
                                @linkModel.ContentPath
                            </p>
                            @if (selectedContent != null)
                            {
                                <div class="d-flex gap-2 mt-2">
                                    <span class="badge bg-primary">@selectedContent.ContentType</span>
                                    <span class="badge bg-secondary">@FormatFileSize(selectedContent.FileSize)</span>
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (IsEditMode && existingLink != null)
                {
                    <hr />
                    <div class="mb-0">
                        <label class="form-label fw-semibold small text-muted">STATISTICS</label>
                        <ul class="list-unstyled small mb-0">
                            <li class="mb-2">
                                <i class="bi bi-cursor text-primary me-2"></i>
                                <strong>@existingLink.ClickCount</strong> clicks
                            </li>
                            <li>
                                <i class="bi bi-calendar text-primary me-2"></i>
                                Created @existingLink.CreatedAt.ToString("MMM dd, yyyy")
                            </li>
                        </ul>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public int? Id { get; set; }

    private LinkModel linkModel = new();
    private Link? existingLink;
    private bool isSubmitting = false;
    private IEnumerable<ContentItem>? availableContent;
    private ContentItem? selectedContent;
    private EditForm? editForm;

    private bool IsEditMode => Id.HasValue;

    ContentService contentService = new();
    LinkService linkService = new();

    protected override async Task OnInitializedAsync()
    {
        // Load available content
        availableContent = await contentService.GetAvailableContentAsync();

        if (IsEditMode && Id.HasValue)
        {
            existingLink = await linkService.GetLinkByIdAsync(Id.Value);
            if (existingLink != null)
            {
                linkModel = new LinkModel
                {
                    Type = existingLink.Type,
                    RedirectUrl = existingLink.RedirectUrl,
                    ContentPath = existingLink.ContentPath,
                    Title = existingLink.Title,
                    ShortCode = existingLink.ShortCode,
                    ExpiresAt = existingLink.ExpiresAt?.Date,
                    IsActive = existingLink.IsActive
                };

                // Load selected content info if it's a content link
                if (linkModel.Type == LinkType.Content && !string.IsNullOrEmpty(linkModel.ContentPath))
                {
                    selectedContent = await contentService.GetContentByPathAsync(linkModel.ContentPath);
                }
            }
            else
            {
                Navigation.NavigateTo("/admin/links");
            }
        }
    }

    private async Task SaveLink()
    {
        isSubmitting = true;

        try
        {
            if (IsEditMode && existingLink != null)
            {
                // Update existing link
                existingLink.Type = linkModel.Type;
                existingLink.RedirectUrl = linkModel.Type == LinkType.Redirect ? linkModel.RedirectUrl : string.Empty;
                existingLink.ContentPath = linkModel.Type == LinkType.Content ? linkModel.ContentPath : null;
                existingLink.ContentType = linkModel.Type == LinkType.Content && selectedContent != null ? selectedContent.ContentType : null;
                existingLink.Title = linkModel.Title ?? string.Empty;
                existingLink.ShortCode = linkModel.ShortCode ?? string.Empty;
                existingLink.ExpiresAt = linkModel.ExpiresAt;
                existingLink.IsActive = linkModel.IsActive;

                await linkService.UpdateLinkAsync(existingLink);
            }
            else
            {
                // Create new link
                var newLink = new Link
                {
                    Type = linkModel.Type,
                    RedirectUrl = linkModel.Type == LinkType.Redirect ? linkModel.RedirectUrl : string.Empty,
                    ContentPath = linkModel.Type == LinkType.Content ? linkModel.ContentPath : null,
                    ContentType = linkModel.Type == LinkType.Content && selectedContent != null ? selectedContent.ContentType : null,
                    Title = linkModel.Title ?? string.Empty,
                    ShortCode = linkModel.ShortCode ?? string.Empty,
                    ExpiresAt = linkModel.ExpiresAt,
                    IsActive = linkModel.IsActive
                };

                await linkService.CreateLinkAsync(newLink);
            }

            Navigation.NavigateTo("/admin/links");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task GenerateShortCode()
    {
        linkModel.ShortCode = await linkService.GenerateUniqueShortCodeAsync();
    }

    private string GetPreviewUrl()
    {
        if (string.IsNullOrEmpty(linkModel.ShortCode))
            return string.Empty;

        return $"{Navigation.BaseUri.TrimEnd('/')}/{linkModel.ShortCode}";
    }

    private async Task CopyToClipboard(string text)
    {
        // Note: In a real application, you would use JavaScript interop to copy to clipboard
        await Task.CompletedTask;
    }

    private async Task OnContentPathChanged()
    {
        if (!string.IsNullOrEmpty(linkModel.ContentPath))
        {
            selectedContent = await contentService.GetContentByPathAsync(linkModel.ContentPath);
        }
        else
        {
            selectedContent = null;
        }

        // Manually trigger validation state update
        if (editForm?.EditContext != null)
        {
            editForm.EditContext.NotifyValidationStateChanged();
        }

        StateHasChanged();
    }

    private string FormatFileSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB" };
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len = len / 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }

    public class LinkModel : IValidatableObject
    {
        public LinkType Type { get; set; } = LinkType.Redirect;

        public string RedirectUrl { get; set; } = string.Empty;

        public string? ContentPath { get; set; }

        [StringLength(200, ErrorMessage = "Title cannot exceed 200 characters")]
        public string? Title { get; set; }

        [StringLength(50, ErrorMessage = "Short code cannot exceed 50 characters")]
        [RegularExpression(@"^[a-zA-Z0-9\-]*$", ErrorMessage = "Short code can only contain letters, numbers, and hyphens")]
        public string? ShortCode { get; set; }

        public DateTime? ExpiresAt { get; set; }

        public bool IsActive { get; set; } = true;

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (Type == LinkType.Redirect)
            {
                if (string.IsNullOrWhiteSpace(RedirectUrl))
                {
                    yield return new ValidationResult("Redirect URL is required for redirect links.", new[] { nameof(RedirectUrl) });
                }
            }
            else if (Type == LinkType.Content)
            {
                if (string.IsNullOrWhiteSpace(ContentPath))
                {
                    yield return new ValidationResult("Content selection is required for content links.", new[] { nameof(ContentPath) });
                }
            }
        }
    }
}
